---
import { getCollection } from "astro:content";
import path from "node:path";
import NotesLayout from "../../../../../layouts/NotesLayout.astro";
import { deepRenderer } from "../../../../../lib/notes-source.mjs";
import { CODE_LANG_NAMES, LEVEL_LABEL, SITE_NAME, TRACKS, appPath, chapterPath, codeLanguages, plain, summary, unitNoun, url, type Chapter, type Notes } from "../../../../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("notes");
  return all.flatMap(e =>
    e.data.chapters.map((ch, i) => ({
      params: { track: e.data.track, app: e.data.slug, chapter: ch.id },
      props: { notes: e.data, index: i },
    })),
  );
}

const { notes, index } = Astro.props as { notes: Notes; index: number };
const { book, chapters, parts } = notes;
const ch: Chapter = chapters[index];
const prev = chapters[index - 1];
const next = chapters[index + 1];
const chUrl = (c: Chapter) => url(chapterPath(notes, c));
const labOwner = (id: string) => chapters.find(c => c.labs.includes(id)) ?? ch;
const diffClass = (d?: string) => (d === "easy" ? "diff-easy" : d === "hard" ? "diff-hard" : "diff-med");
const diffOf = (d?: string) => (d === "easy" || d === "hard" ? d : "med");
const DIFFS = [["easy", "Easy"], ["med", "Medium"], ["hard", "Hard"]] as const;
const diffCounts: Record<string, number> = {};
for (const qa of ch.interview) diffCounts[diffOf(qa.diff)] = (diffCounts[diffOf(qa.diff)] ?? 0) + 1;

// A problem breakdown opens on Problem and Solution and embeds its labs in the sections instead of a Labs tab.
const isProblem = !!ch.problem;
const renderer = deepRenderer(path.join(process.cwd(), "public"));
const labInfo = (id: string) => notes.labInfo[id];
const deep = notes.deep[ch.id];
const deepHtml = deep
  ? renderer.render(deep, { sectionHref: (id: string) => `#learn-${id}`, labInfo, ...(isProblem && { tocTitle: "Deep dives", labAnchors: true }) })
  : "";
const article = (sections: typeof ch.problem, prefix: string, tocTitle: string) =>
  sections ? renderer.article(sections, { prefix, tocTitle, labInfo, labAnchors: true }) : "";
const problemHtml = article(ch.problem, "problem", "The problem");
const solutionHtml = article(ch.solution, "solution", "The solution");
const levelsHtml = article(ch.levels, "levels", "By level");
const hasLab = (sections: { blocks: { type: string }[] }[] = []) => sections.some(s => s.blocks.some(b => b.type === "lab"));
const embeddedLabs = hasLab(deep?.sections) || hasLab(ch.problem) || hasLab(ch.solution) || hasLab(ch.levels);
const firstTab = isProblem ? "problem" : "concepts";
const codeLangs = codeLanguages([ch], notes.deep);
// A problem breakdown reads Problem, Solution, Deep Dives, then the reference tabs; chapters lead with Core Concepts.
const deepAfterSolution = isProblem;

const pagePath = chapterPath(notes, ch);
const bookTitle = plain(book.title);
const title = `${plain(ch.title)} · ${book.shortTitle ?? bookTitle}`;
const description = summary(ch.overview);
const site = Astro.site!;
const abs = (p: string) => new URL(url(p), site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: plain(ch.title),
    headline: plain(ch.title),
    description: summary(ch.overview, 300),
    url: abs(pagePath),
    learningResourceType: "Study notes",
    educationalLevel: "Professional",
    teaches: ch.concepts.map(c => plain(c.term)),
    isPartOf: { "@type": "Course", name: bookTitle, url: abs(appPath(notes)) },
    ...(ch.source && { isBasedOn: ch.source.url }),
    position: index + 1,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE_NAME, item: abs("") },
      { "@type": "ListItem", position: 2, name: TRACKS[notes.track] ?? notes.track, item: abs(`${notes.track}/`) },
      { "@type": "ListItem", position: 3, name: bookTitle, item: abs(appPath(notes)) },
      { "@type": "ListItem", position: 4, name: plain(ch.title), item: abs(pagePath) },
    ],
  },
];
---
<NotesLayout notes={notes} chapter={ch.id} title={title} description={description} path={pagePath} structuredData={structuredData} labs={ch.labs.length > 0 || embeddedLabs}>
  <div class="chapter-header">
    <div class="chapter-label"><Fragment set:html={`${unitNoun(ch)} ${ch.number} &middot; ${parts[ch.part]}`} />{ch.difficulty && <span class={`level-pill level-${ch.difficulty}`}>{LEVEL_LABEL[ch.difficulty]}</span>}</div>
    <h1 set:html={ch.title} />
    <div class="overview-text" set:html={ch.overview} />
    {ch.source && <div class="chapter-source">Reference: <a href={ch.source.url} target="_blank" rel="noopener" set:html={ch.source.title} /> &#8599;</div>}
    {codeLangs.length > 1 && (
      <label class="code-lang-picker">Code in
        <select data-code-lang-select aria-label="Programming language for code examples">
          {codeLangs.map(l => <option value={l}>{CODE_LANG_NAMES[l] ?? l}</option>)}
        </select>
      </label>
    )}
  </div>

  {isProblem ? (
    <nav class="tabs" aria-label="Problem sections" data-first-tab={firstTab}>
      <a class="tab active" href="#problem" data-tab="problem">Problem</a>
      <a class="tab" href="#solution" data-tab="solution">Solution</a>
      {deep && deepAfterSolution && <a class="tab learn-tab" href="#learn" data-tab="learn">Deep Dives <span class="tab-count" data-tab-count="learn">0/{deep.sections.length}</span></a>}
      <a class="tab" href="#concepts" data-tab="concepts">Core Concepts <span class="tab-count" data-tab-count="concepts">0/{ch.concepts.length}</span></a>
      {deep && !deepAfterSolution && <a class="tab learn-tab" href="#learn" data-tab="learn">Deep Dives <span class="tab-count" data-tab-count="learn">0/{deep.sections.length}</span></a>}
      <a class="tab" href="#interview" data-tab="interview">Interview Q&amp;A <span class="tab-count" data-tab-count="interview">0/{ch.interview.length}</span></a>
      <a class="tab" href="#levels" data-tab="levels">By Level</a>
      <a class="tab" href="#cheatsheet" data-tab="cheatsheet">Cheatsheet <span class="tab-count">{ch.cheatsheet.length}</span></a>
    </nav>
  ) : (
    <nav class="tabs" aria-label="Chapter sections" data-first-tab={firstTab}>
      <a class="tab active" href="#concepts" data-tab="concepts">Core Concepts <span class="tab-count" data-tab-count="concepts">0/{ch.concepts.length}</span></a>
      {deep && <a class="tab learn-tab" href="#learn" data-tab="learn">Deep Dive <span class="tab-count" data-tab-count="learn">0/{deep.sections.length}</span></a>}
      <a class="tab labs-tab" href="#labs" data-tab="labs">&#9654; Interactive Labs <span class="tab-count">{ch.labs.length}</span></a>
      <a class="tab" href="#interview" data-tab="interview">Interview Q&amp;A <span class="tab-count" data-tab-count="interview">0/{ch.interview.length}</span></a>
      <a class="tab" href="#cheatsheet" data-tab="cheatsheet">Cheatsheet <span class="tab-count">{ch.cheatsheet.length}</span></a>
    </nav>
  )}

  {isProblem && (
    <>
      <section id="problem" data-panel="problem"><Fragment set:html={problemHtml} /></section>
      <section id="solution" data-panel="solution"><Fragment set:html={solutionHtml} /></section>
    </>
  )}

  {deep && deepAfterSolution && (
    <section id="learn" data-panel="learn">
      <Fragment set:html={deepHtml} />
    </section>
  )}

  <section id="concepts" data-panel="concepts">
    <h2 class="sr-only">Core concepts</h2>
    <div class="concepts-toolbar" hidden>
      <input type="search" class="tool-filter" id="conceptFilter" placeholder={`Filter ${ch.concepts.length} concepts...`} aria-label="Filter concepts" autocomplete="off">
      <div class="seg" role="group" aria-label="Show">
        <button class="on" data-show="all">All</button>
        <button data-show="todo">To learn <span class="seg-count" data-show-count="todo"></span></button>
        <button data-show="done">Learned <span class="seg-count" data-show-count="done"></span></button>
      </div>
      <button class="iconbtn selftest-toggle" aria-pressed="false">Hide definitions</button>
      <span class="selftest-hint">Test yourself: hide the definitions and reveal one card at a time.</span>
    </div>
    <div class="concepts-grid">
      {ch.concepts.map((c, i) => {
        const lab = c.demo ? notes.labInfo[c.demo] : undefined;
        return (
          <div class="concept-card">
            <button class="learn-toggle" data-idx={i} title="Mark as learned" aria-label="Mark as learned" aria-pressed="false"></button>
            <div class="concept-term" set:html={c.term} />
            <div class="concept-def" set:html={c.def} />
            {c.why && <div class="concept-why" set:html={c.why} />}
            {c.ex && <div class="concept-example" set:html={c.ex} />}
            {lab && c.demo && <a class="concept-demo-link" href={`${chUrl(labOwner(c.demo))}#lab-${c.demo}`}>&#9654; See it live: <Fragment set:html={lab.title} /></a>}
            <button class="iconbtn reveal-btn">Reveal</button>
          </div>
        );
      })}
    </div>
    <div class="empty-tab filter-empty" id="conceptEmpty" hidden></div>
  </section>

  {deep && !deepAfterSolution && (
    <section id="learn" data-panel="learn">
      <Fragment set:html={deepHtml} />
    </section>
  )}

  {!isProblem && (
    <section id="labs" data-panel="labs">
      <h2 class="sr-only">Interactive labs</h2>
      {ch.labs.length === 0 ? (
        <div class="empty-tab">No labs for this chapter.</div>
      ) : (
        <>
          <div class="labs-intro" set:html={book.labsIntro} />
          {ch.labs.map(id => (
            <section class="lab-card" id={`lab-${id}`}>
              <div class="lab-head"><span class="lab-tag">Lab</span><h3 set:html={notes.labInfo[id].title} /></div>
              <div class="lab-blurb" set:html={notes.labInfo[id].blurb} />
              <div class="lab-body" data-lab={id}><noscript><div class="lab-note">This lab needs JavaScript.</div></noscript></div>
            </section>
          ))}
        </>
      )}
    </section>
  )}

  <section id="interview" data-panel="interview">
    <h2 class="sr-only">Interview questions and answers</h2>
    <div class="concepts-toolbar qa-toolbar" hidden>
      <div class="seg" role="group" aria-label="Difficulty">
        <button class="on" data-diff="all">All <span class="seg-count">{ch.interview.length}</span></button>
        {DIFFS.filter(([d]) => diffCounts[d]).map(([d, label]) => <button data-diff={d}>{label} <span class="seg-count">{diffCounts[d]}</span></button>)}
      </div>
      <label class="tool-check"><input type="checkbox" id="qaHideReviewed"> Hide reviewed</label>
      <button class="iconbtn" id="qaExpandAll">Expand all</button>
    </div>
    <p class="tab-tip">Answer out loud first, then open the model answer and compare.</p>
    {ch.interview.map((qa, i) => (
      <div class="qa-item" data-diff={diffOf(qa.diff)}>
        <div class="qa-header" role="button" tabindex="0" aria-expanded="false">
          <span class={`diff-badge ${diffClass(qa.diff)}`}>{qa.diff ?? "med"}</span>
          <h3 class="qa-q" set:html={qa.q} />
          <span class="qa-chevron">&#9662;</span>
        </div>
        <div class="qa-body">
          <div class="qa-body-inner" set:html={qa.a} />
          <div class="qa-footer"><button class="review-btn" data-idx={i}>Mark reviewed</button></div>
        </div>
      </div>
    ))}
    <div class="empty-tab filter-empty" id="qaEmpty" hidden>No questions left with these filters.</div>
  </section>

  {isProblem && <section id="levels" data-panel="levels"><Fragment set:html={levelsHtml} /></section>}

  <section id="cheatsheet" data-panel="cheatsheet">
    <h2 class="sr-only">Cheatsheet</h2>
    <div class="cheatsheet-actions"><a class="iconbtn" href={url(`${appPath(notes)}cheatsheet/`)}>&#8801; All chapters, printable</a></div>
    {ch.cheatsheet.map(cs => (
      <div class="cheatsheet-block">
        <h3 set:html={cs.title} />
        {cs.type === "table" && (
          <table>
            <thead><tr>{cs.headers.map(h => <th set:html={h} />)}</tr></thead>
            <tbody>{cs.rows.map(r => <tr>{r.map(c => <td set:html={String(c)} />)}</tr>)}</tbody>
          </table>
        )}
        {cs.type === "list" && <ul>{cs.items.map(it => <li set:html={it} />)}</ul>}
        {cs.type === "code" && <Fragment set:html={renderer.codeHtml(cs.body, cs.lang, cs.alt)} />}
        {cs.note && <div class="cs-note" set:html={cs.note} />}
      </div>
    ))}
  </section>

  <nav class="chapter-footer" aria-label="Chapters">
    {prev ? <a class="nav-btn" href={chUrl(prev)} rel="prev"><div class="nav-btn-label">&larr; Previous</div>{unitNoun(prev, true)} {prev.number}: <Fragment set:html={prev.title} /></a> : <div></div>}
    {next ? <a class="nav-btn right" href={chUrl(next)} rel="next"><div class="nav-btn-label">Next &rarr;</div>{unitNoun(next, true)} {next.number}: <Fragment set:html={next.title} /></a> : <div></div>}
  </nav>
</NotesLayout>
