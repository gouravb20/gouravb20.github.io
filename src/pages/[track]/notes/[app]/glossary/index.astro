---
import { getCollection } from "astro:content";
import NotesLayout from "../../../../../layouts/NotesLayout.astro";
import { SITE_NAME, TRACKS, appPath, chapterPath, plain, shortLabel, summary, unitNoun, url, type Notes } from "../../../../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("notes");
  return all.map(e => ({ params: { track: e.data.track, app: e.data.slug }, props: { notes: e.data } }));
}

const { notes } = Astro.props as { notes: Notes };
const { book, chapters } = notes;

const terms = chapters
  .flatMap(ch => ch.concepts.map((c, i) => {
    const term = plain(c.term);
    const label = shortLabel(c.term);
    return { ch, c, i, term, label, sort: label };
  }))
  .sort((a, b) => a.sort.localeCompare(b.sort, "en", { sensitivity: "base" }) || a.term.localeCompare(b.term, "en", { sensitivity: "base" }));
const groups = new Map<string, typeof terms>();
for (const t of terms) {
  const first = t.label.charAt(0).toUpperCase();
  const key = /[A-Z]/.test(first) ? first : "#";
  groups.set(key, [...(groups.get(key) ?? []), t]);
}
const letters = [...groups.keys()].sort();

const path = `${appPath(notes)}glossary/`;
const bookTitle = plain(book.title);
const title = `Glossary · ${book.shortTitle ?? bookTitle}`;
const description = `${terms.length} terms from ${bookTitle}, A to Z — short labels with one-line definitions.`;
const site = Astro.site!;
const abs = (p: string) => new URL(url(p), site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    name: `${bookTitle} glossary`,
    url: abs(path),
    hasDefinedTerm: terms.map(t => ({ "@type": "DefinedTerm", name: t.term, description: plain(t.c.def), url: abs(chapterPath(notes, t.ch)) })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: SITE_NAME, item: abs("") },
      { "@type": "ListItem", position: 2, name: TRACKS[notes.track] ?? notes.track, item: abs(`${notes.track}/`) },
      { "@type": "ListItem", position: 3, name: bookTitle, item: abs(appPath(notes)) },
      { "@type": "ListItem", position: 4, name: "Glossary", item: abs(path) },
    ],
  },
];
---
<NotesLayout notes={notes} view="glossary" title={title} description={description} path={path} structuredData={structuredData}>
  <div class="chapter-header">
    <div class="chapter-label">Reference</div>
    <h1>Glossary</h1>
    <div class="overview-text">{terms.length} terms · short labels · click for the chapter</div>
    <div class="ref-tools" hidden>
      <input type="search" class="tool-filter" id="glFilter" placeholder="Filter…" aria-label="Filter glossary" autocomplete="off">
      <select class="sel" id="glChapter" aria-label="Only show one chapter">
        <option value="">All chapters</option>
        {chapters.filter(ch => ch.concepts.length).map(ch => <option value={ch.id}>{unitNoun(ch, true)} {ch.number}: {plain(ch.title)}</option>)}
      </select>
      <span id="glCount" data-total={terms.length}>{terms.length}</span>
    </div>
  </div>

  <nav class="letter-bar" aria-label="Jump to letter">
    {letters.map(L => <a href={`#gl-${L}`} data-letter={L}>{L}</a>)}
  </nav>

  {letters.map(L => (
    <section class="gl-group" id={`gl-${L}`}>
      <h2 class="gl-letter">{L}</h2>
      {groups.get(L)!.map(t => (
        <a class="gl-item" href={url(chapterPath(notes, t.ch))} data-ch={t.ch.id} data-idx={t.i} title={t.term}>
          <div class="gl-term"><span>{t.label}</span><span class="gl-ch">{t.ch.number}</span></div>
          <div class="gl-def">{summary(t.c.def, 90)}</div>
          <span class="gl-full">{t.term}</span>
        </a>
      ))}
    </section>
  ))}
  <div class="empty-tab filter-empty" id="glEmpty" hidden></div>
</NotesLayout>
