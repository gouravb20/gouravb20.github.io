---
import { SITE_NAME, TRACKS, appPath, chapterPath, jsonLd, plain, sortedParts, url, type Notes } from "../lib/site";

interface Props {
  notes: Notes;
  /** Chapter id, or undefined on the dashboard. */
  chapter?: string;
  /** Book-wide page shown instead of a chapter. */
  view?: "glossary" | "cheatsheet";
  title: string;
  description: string;
  /** Path under the base, ending in "/". */
  path: string;
  structuredData: object[];
  /** Load the lab scripts (labkit.js and the app's demos*.js). */
  labs?: boolean;
}

const { notes, chapter, view, title, description, path, structuredData, labs = false } = Astro.props;
const { book } = notes;
const canonical = new URL(url(path), Astro.site).href;
const brand = book.shortTitle ?? plain(book.title);
const ring = 2 * Math.PI * 8;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0a0f1c">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content={SITE_NAME}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary">
  <link rel="icon" href={url("favicon.svg")} type="image/svg+xml">
  <link rel="sitemap" href={url("sitemap-index.xml")}>
  <link rel="stylesheet" href={url("shared/styles.css")}>
  <script is:inline>
    (function () {
      try {
        var s = localStorage.getItem("system_design_skin");
        if (s && s !== "classic") document.documentElement.setAttribute("data-skin", s);
      } catch (e) {}
    })();
  </script>
  <script src={url("shared/looks.js")} is:inline></script>
  {structuredData.map(d => <script type="application/ld+json" set:html={jsonLd(d)} />)}
  <slot name="head" />
</head>
<body
  data-storage-key={book.storageKey}
  data-app-id={book.appId}
  data-export-prefix={book.exportPrefix}
  data-search-url={url(`${appPath(notes)}search.json`)}
  data-chapter={chapter ?? ""}
>
  <script is:inline>
    try {
      if (window.SDLooks) window.SDLooks.boot();
      else if (JSON.parse(localStorage.getItem(document.body.dataset.storageKey || "") || "{}").theme === "light") document.body.classList.add("light");
    } catch (e) {}
  </script>

  <header class="topbar">
    <button class="menu-toggle" id="menuToggle" aria-label="Open chapters menu" title="Chapters">&#9776;</button>
    <a class="iconbtn home-btn" href={url(`${notes.track}/index.html`)} title={`${TRACKS[notes.track] ?? "All"} notes (home)`} aria-label="Home">&#8962;<span> Home</span></a>

    <a class="brand" href={url(appPath(notes))}>
      <div class="logo">{book.mono ?? brand.slice(0, 2).toUpperCase()}</div>
      {brand}
      {book.tagline && <span class="brand-sub">{book.tagline}</span>}
    </a>

    <div class="topbar-spacer"></div>

    <div class="progress-pill" title="Overall progress across all chapters">
      <span id="overallProgressText">0%</span>
      <div class="progress-pill-bar"><div class="progress-pill-fill" id="overallProgressFill" style="width:0%"></div></div>
    </div>

    <div class="search-wrap">
      <input type="search" class="search-box" id="searchBox" placeholder="Search concepts, labs, questions... (press /)" aria-label="Search these notes">
      <div class="search-results" id="searchResults"></div>
    </div>

    <button class="iconbtn" id="exportBtn" title="Export your progress to a file">&#11015; Export</button>
    <button class="iconbtn" id="importBtn" title="Import progress from a file">&#11014; Import</button>
    <input type="file" id="importFile" accept="application/json,.json" style="display:none">
    <button class="iconbtn" id="themeToggle" title="Toggle theme">Light</button>
    <button class="iconbtn" id="resetBtn" title="Reset all progress">Reset</button>

    <div class="more-wrap">
      <button class="more-toggle" id="moreToggle" aria-label="More actions" title="More">&#8943;</button>
      <div class="more-menu" id="moreMenu">
        <button class="iconbtn" data-action="export">&#11015; Export progress</button>
        <button class="iconbtn" data-action="import">&#11014; Import progress</button>
        <button class="iconbtn" data-action="theme">&#9728; Toggle theme</button>
        <button class="iconbtn" data-action="reset">&#10227; Reset progress</button>
      </div>
    </div>
  </header>

  <div class="backdrop" id="backdrop"></div>

  <div class="layout">
    <aside class="sidebar" id="sidebar">
      <nav aria-label="Chapters">
        <a class={`chapter-item${chapter || view ? "" : " active"}`} href={url(appPath(notes))}>
          <div class="chapter-num">&#10022;</div><div class="chapter-title">Dashboard</div>
        </a>
        <a class={`chapter-item${view === "glossary" ? " active" : ""}`} href={url(`${appPath(notes)}glossary/`)} aria-current={view === "glossary" ? "page" : undefined}>
          <div class="chapter-num">A&ndash;Z</div><div class="chapter-title">Glossary</div>
        </a>
        <a class={`chapter-item${view === "cheatsheet" ? " active" : ""}`} href={url(`${appPath(notes)}cheatsheet/`)} aria-current={view === "cheatsheet" ? "page" : undefined}>
          <div class="chapter-num">&#8801;</div><div class="chapter-title">All cheatsheets</div>
        </a>
        {sortedParts(notes).map(part => (
          <>
            <div class="part-header" set:html={notes.parts[part]} />
            {notes.chapters.filter(ch => ch.part === part).map(ch => (
              <a
                class={`chapter-item${ch.id === chapter ? " active" : ""}`}
                href={url(chapterPath(notes, ch))}
                data-chapter={ch.id}
                data-total={ch.concepts.length + ch.interview.length}
                aria-current={ch.id === chapter ? "page" : undefined}
              >
                <div class="chapter-num">{ch.number}</div>
                <div class="chapter-title" set:html={ch.title} />
                <div class="chapter-ring">
                  <svg viewBox="0 0 20 20"><circle class="bg" cx="10" cy="10" r="8" /><circle class="fg" cx="10" cy="10" r="8" stroke-dasharray={ring} stroke-dashoffset={ring} /></svg>
                </div>
              </a>
            ))}
          </>
        ))}
      </nav>
    </aside>
    <main class="main" id="main">
      <slot />
    </main>
  </div>

  <div class="toast" id="toast"></div>

  {labs && notes.labScripts.map(src => <script is:inline src={url(src)}></script>)}
  <script>
    import "../scripts/notes-client.ts";
  </script>
</body>
</html>
